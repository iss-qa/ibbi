# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Sistema de Gestão de Pessoas (multi-tenant) — variáveis do BACKEND  ║
# ║  Copie para .env e preencha. NUNCA versionar o .env real.            ║
# ║  Cada variável aparece UMA vez — linhas repetidas: a última vence.   ║
# ╚══════════════════════════════════════════════════════════════════════╝


# ─── 1. SERVIDOR ─────────────────────────────────────────────────────────
# Porta HTTP da API (o frontend em dev aponta para http://localhost:3001/api)
PORT=3001
# development = local | production = servidor. Em production o seed de dev é bloqueado.
NODE_ENV=development
# Fuso padrão (cada igreja também tem o seu em Configurações → Igreja)
APP_TIMEZONE=America/Bahia
# URL pública do portal — usada nos links enviados por WhatsApp/email
APP_URL=http://localhost:5173
# Opcional: domínio para acesso por subdomínio (<codigo-da-igreja>.APP_BASE_DOMAIN)
APP_BASE_DOMAIN=
# Opcional: origens extras liberadas no CORS, separadas por vírgula
CORS_ORIGINS=

# ─── 2. BANCO DE DADOS ───────────────────────────────────────────────────
# ⚠️ Deixe só UMA linha MONGO_URI ativa. Na 1ª subida o servidor migra o banco (multi-tenant).
MONGO_URI=mongodb://localhost:27017/ibbi_local
#DB_MONGO=ibbi_prod
# PRODUÇÃO — não usar em dev (duas MONGO_URI: a última vence)
# MONGO_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/ibbi_prod?retryWrites=true&w=majority


# ─── 3. SEGURANÇA ────────────────────────────────────────────────────────
# Segredo que assina os tokens de login. Longo e aleatório; trocar desloga todos.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=TROCAR_POR_UM_SEGREDO_FORTE_ALEATORIO
# Validade do login das igrejas
JWT_EXPIRES_IN=7d
# Chave AES-256 (64 caracteres hex) que criptografa as credenciais de WhatsApp das igrejas.
# Defina ANTES de salvar credenciais — trocar depois torna as já salvas ilegíveis.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# reCAPTCHA v3 no login (opcional — vazio desativa). Site key vai no frontend (VITE_RECAPTCHA_SITE_KEY).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5


# ─── 4. MULTI-TENANT E PAINEL DA PLATAFORMA ─────────────────────────────
# Código da igreja usado quando o login não informa outro (tenant fundador)
DEFAULT_TENANT_SLUG=ibbi
# Operador do painel /platform (gestão de igrejas, planos e faturas).
# Criado automaticamente na subida do servidor se ainda não existir.
PLATFORM_ADMIN_NAME=Administrador da Plataforma
PLATFORM_ADMIN_EMAIL=admin@localhost
PLATFORM_ADMIN_PASSWORD=TROCAR_SENHA_ADMIN_PLATAFORMA
# Validade do login do painel da plataforma
PLATFORM_JWT_EXPIRES_IN=12h


# ─── 5. USUÁRIOS E SEEDS ─────────────────────────────────────────────────
# Senha inicial de usuários criados pelo sistema (troca obrigatória no 1º acesso)
DEFAULT_USER_PASSWORD=TROCAR_SENHA_PADRAO
# Senha do master criado pelo `npm run seed`
SEED_MASTER_PASSWORD=TROCAR_SENHA_MASTER
# `npm run seed:dev` — usuários membro.teste e admin.teste (só roda contra MongoDB local)
DEV_MEMBRO_PASSWORD=Dev@12345
DEV_ADMIN_PASSWORD=Dev@12345
# Scripts de manutenção: igreja alvo (padrão: DEFAULT_TENANT_SLUG)
TENANT_SLUG=
# Forçar o seed de dev fora do Mongo local (evite)
ALLOW_DEV_SEED=false


# ─── 6. WHATSAPP — EVOLUTION API (não oficial, QR Code) ─────────────────
# Anti-bloqueio (padrões; cada igreja ajusta em Configurações → WhatsApp). Mínimo 30s.
WHATSAPP_MIN_DELAY_SEG=45
WHATSAPP_MAX_DELAY_SEG=90
WHATSAPP_HORARIO_INICIO=08:00
WHATSAPP_HORARIO_FIM=21:00
WHATSAPP_LIMITE_HORA=60
WHATSAPP_LIMITE_DIA=400
WHATSAPP_PAUSA_A_CADA=20
WHATSAPP_PAUSA_MIN=5
WHATSAPP_DIGITANDO=true
# Usado pela igreja fundadora e por igrejas sem WhatsApp próprio configurado.
# Cada igreja pode ter sua própria instância em Configurações → WhatsApp.
EVOLUTION_API_URL=https://sua-evolution-api.exemplo.com
EVOLUTION_INSTANCE=SuaInstancia
EVOLUTION_API_KEY=TROCAR_POR_SUA_API_KEY
# true apenas se o servidor da Evolution usar certificado autoassinado
EVOLUTION_ALLOW_SELF_SIGNED=false
# Frequência do monitor de conexão (cron). Padrão: a cada 5 minutos
EVOLUTION_MONITOR_CRON=*/5 * * * *
# Número que recebe os pedidos de oração da igreja fundadora (com 55 + DDD)
CHURCH_WHATSAPP_NUMBER=5500000000000


# ─── 7. WHATSAPP — API OFICIAL (Cloud API da Meta) ──────────────────────
# Webhook no painel da Meta: GET/POST {APP_URL}/api/webhooks/whatsapp (campo "messages")
# Token que você inventa e cola também no painel da Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret do app da Meta — valida a assinatura dos webhooks
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0


# ─── 8. MODO TESTE DO WHATSAPP (só dev) ─────────────────────────────────
# Com FORCE_MOCK_RECIPIENT=true TODAS as mensagens (WhatsApp e email) vão para os destinos de teste.
# Recomendado ao rodar local com dados reais, para não mandar mensagem para membros.
MOCK_WHATSAPP_NUMBER=5500000000000
FORCE_MOCK_RECIPIENT=true
# Exceções do modo teste: estes números recebem de verdade (separados por vírgula)
MOCK_ALLOWED_NUMBERS=
# Grupos de WhatsApp no modo teste: true para permitir envio a grupos (use um grupo de teste)
MOCK_ALLOW_GROUPS=false
# Emails no modo teste: vão para MOCK_EMAIL (vazio = não envia), exceto MOCK_ALLOWED_EMAILS
MOCK_EMAIL=
MOCK_ALLOWED_EMAILS=
# Número conectado na instância padrão do servidor (usado no cartão de contato e no modo de teste)
WHATSAPP_NUMERO_INSTANCIA=
# Teste no próprio celular: conversa "consigo mesmo" vira mensagem para o assistente (só dev)
WHATSAPP_SELF_CHAT_TEST=false
# Se preenchido, só mensagens destes números são processadas (proteja um número pessoal)
WHATSAPP_INBOUND_ALLOWLIST=
EVOLUTION_ALLOW_SELF_SIGNED=true


# ─── 9. EMAIL (SMTP) ─────────────────────────────────────────────────────
# Aniversários por email, alertas de ausência, cobrança e alertas do monitor.
# Gmail: use uma "senha de app" (não a senha da conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=PastorIA <seu-email@gmail.com>
ALERT_EMAIL=alertas@suaigreja.com.br


# ─── 10. INTELIGÊNCIA ARTIFICIAL ─────────────────────────────────────────
# Provedor: gemini | anthropic. Vazio = Anthropic se houver ANTHROPIC_API_KEY, senão Gemini.
# Sem nenhuma chave, o assistente fica desligado e as mensagens usam templates fixos.
AI_PROVIDER=gemini
# Google Gemini (aistudio.google.com → Get API key)
GEMINI_API_KEY=
# Modelo Gemini: gemini-3.8-flash (padrão) | gemini-3.1-pro-preview (mais capaz). Os 2.5 não são liberados para contas novas.
GEMINI_MODEL=gemini-3.8-flash
# Anthropic Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Nome do produto usado pelo assistente ("Sou Eliézer, assistente da PastorIA")
PRODUCT_NAME=PastorIA
# Modelo do agente e dos textos. Para reduzir custo em volume, avalie claude-sonnet-5.
AI_MODEL=claude-opus-5
# Profundidade de raciocínio: low | medium | high
# Custo de IA no painel da plataforma: câmbio US$→R$ e preço de modelos fora da tabela (config/ai-pricing.js)
USD_BRL=5.4
# AI_PRICE_INPUT_USD=
# AI_PRICE_CACHED_USD=
# AI_PRICE_OUTPUT_USD=
# Cache de contexto do Gemini (padrão ligado; 'off' desliga). TTL em segundos, renovado enquanto houver uso.
GEMINI_CACHE=on
GEMINI_CACHE_TTL_SEG=600
AI_EFFORT=medium


# ─── 11. TRANSCRIÇÃO DE ÁUDIO (áudios do WhatsApp) ──────────────────────
# Endpoint compatível com /audio/transcriptions (OpenAI, Groq…). Vazio = usa o Gemini, se houver chave.
TRANSCRIPTION_API_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1


# ─── 12. COBRANÇA (Asaas — PIX, boleto, cartão) ─────────────────────────
# Vazio = faturas só com baixa manual no painel da plataforma
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3
# Token do webhook do Asaas → POST {APP_URL}/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=
# Dias de atraso até marcar a igreja como inadimplente / suspender o acesso
BILLING_GRACE_DAYS=3
BILLING_SUSPEND_AFTER_DAYS=15
# Duração do período de teste de novas igrejas
TRIAL_DAYS=14


# ─── 13. INFRA (normalmente não mexer) ──────────────────────────────────
# Caminho do Chromium para gerar cartões de aniversário (o Dockerfile já define)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium


# ╔══════════════════════════════════════════════════════════════════════╗
# ║  FRONTEND — ficam em frontend/.env.development.local (dev) ou no     ║
# ║  build (VITE_*). Veja frontend/.env.example.                         ║
# ║   VITE_API_URL, VITE_DEFAULT_TENANT, VITE_RECAPTCHA_SITE_KEY,        ║
# ║   VITE_DEV_USERS (atalhos de login só em localhost)                  ║
# ╚══════════════════════════════════════════════════════════════════════╝
