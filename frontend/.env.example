# ╔══════════════════════════════════════════════════════════════════╗
# ║  FRONTEND (Vite) — copie para frontend/.env.development.local     ║
# ║  (ignorado pelo git). Variáveis VITE_* entram no bundle: nunca    ║
# ║  coloque segredos aqui, exceto VITE_DEV_USERS (removido no build).║
# ╚══════════════════════════════════════════════════════════════════╝

# URL da API. Vazio: dev usa http://localhost:3001/api e produção usa /api
VITE_API_URL=

# Código da igreja pré-selecionado no login
VITE_DEFAULT_TENANT=ibbi

# reCAPTCHA v3 — site key pública (a secret fica no backend: RECAPTCHA_SECRET_KEY)
VITE_RECAPTCHA_SITE_KEY=

# Atalhos de login — só aparecem em `npm run dev` acessando por localhost; não vão para o build.
# membro/admin: usuários do `npm run seed:dev`. plataforma: PLATFORM_ADMIN_EMAIL/PASSWORD do .env do backend.
VITE_DEV_USERS={"membro":{"login":"membro.teste","senha":"Dev@12345","igreja":"ibbi"},"admin":{"login":"admin.teste","senha":"Dev@12345","igreja":"ibbi"},"plataforma":{"email":"admin@localhost","senha":"Dev@12345"}}

# WhatsApp comercial (só dígitos, com DDI) para o botão "Falar com a equipe" do plano Rede na landing page. Vazio = leva ao cadastro.
VITE_CONTACT_WHATSAPP=

# Mostra o botão "Ver demonstração" na landing (exige DEMO_ENABLED=true no backend).
VITE_DEMO_ENABLED=false
# Email de contato/privacidade exibido nos Termos e na Política de Privacidade.
VITE_CONTACT_EMAIL=
